generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_items {
  id               Int              @id @default(autoincrement())
  order_id         Int
  variant_id       Int
  product_name     String
  size             String
  color            String
  unit_price       Decimal          @db.Decimal(12, 2)
  quantity         Int
  line_total       Decimal?         @default(dbgenerated("(unit_price * (quantity)::numeric)")) @db.Decimal
  orders           orders           @relation(fields: [order_id], references: [id], onUpdate: NoAction)
  product_variants product_variants @relation(fields: [variant_id], references: [id], onUpdate: NoAction)

  @@index([order_id])
  @@index([variant_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  notifications  admin_notifications[]
  checkout_key   String?       @unique @db.Uuid
  checkout_hash  String?
  id             Int           @id @default(autoincrement())
  reference      String        @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_name  String
  phone          String
  wilaya         String
  commune        String
  address        String
  status         String        @default("new")
  payment_method String        @default("cash_on_delivery")
  subtotal       Decimal       @db.Decimal(12, 2)
  delivery_fee   Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal?      @default(dbgenerated("(subtotal + delivery_fee)")) @db.Decimal(13, 2)
  notes          String        @default("")
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  order_items    order_items[]

  @@index([created_at(sort: Desc)])
  @@index([status, created_at(sort: Desc)])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model product_variants {
  id          Int           @id @default(autoincrement())
  product_id  Int
  size        String
  color       String
  stock       Int           @default(0)
  is_active   Boolean       @default(true)
  order_items order_items[]
  products    products      @relation(fields: [product_id], references: [id], onUpdate: NoAction)

  @@unique([product_id, size, color])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  images           product_images[]
  id               Int                @id @default(autoincrement())
  name             String
  description      String             @default("")
  price            Decimal            @db.Decimal(12, 2)
  image_url        String?
  is_active        Boolean            @default(true)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  product_variants product_variants[]
}

model product_images {
  id         Int      @id @default(autoincrement())
  product_id Int
  url        String
  position   Int      @default(0)
  product    products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id, position])
}

model schema_migrations {
  name       String   @id
  applied_at DateTime @default(now()) @db.Timestamptz(6)
}

model admins {
  notification_reads notification_reads[]
  sessions      admin_sessions[]
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password_hash String
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
}

model admin_notifications {
  id         Int      @id @default(autoincrement())
  order_id   Int
  kind       String
  status     String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  order      orders   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  reads      notification_reads[]

  @@index([order_id])
}

model notification_reads {
  notification_id Int
  admin_id        Int
  read_at         DateTime @default(now()) @db.Timestamptz(6)
  notification    admin_notifications @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  admin           admins @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@id([notification_id, admin_id])
  @@index([admin_id])
}

model admin_sessions {
  token_hash String   @id
  admin_id   Int
  expires_at DateTime @db.Timestamptz(6)
  admin      admins   @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@index([admin_id])
  @@index([expires_at])
}

/// Fees are in DZD. Orders retain the fee charged at checkout.
model delivery_rates {
  id          Int      @id @default(autoincrement())
  wilaya_code String   @unique
  wilaya_name String
  fee         Decimal  @db.Decimal(12, 2)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
}
